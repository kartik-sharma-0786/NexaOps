#####################################################################
# NexaOps - production environment template
#
# Copy to `.env` on your VPS and fill values:
#   cp .env.example .env
#####################################################################

# --- Domains (used by NextAuth and any frontend runtime config)
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=CHANGE_ME_LONG_RANDOM

# If your frontend calls the API from the browser, set this too.
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# --- API
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins (defaults to NEXTAUTH_URL)
# CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# --- Email (optional — emails log to console when SMTP_HOST is unset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=NexaOps <no-reply@your-domain.com>

# --- Error tracking (optional)
# SENTRY_DSN=

# --- Database (managed or containerized Postgres)
# For Vercel, replace this with a managed Postgres connection string; `postgres` only works in Docker Compose.
# For containerized Postgres (default compose-prod), keep host as `postgres`
DATABASE_URL=postgres://nexaops:CHANGE_ME_DB_PASSWORD@postgres:5432/nexaops_db
POSTGRES_USER=nexaops
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=nexaops_db

# --- Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Set to false when using Redis < 5 (e.g. Windows Redis 3.0). Emails run inline instead.
NOTIFICATIONS_QUEUE_ENABLED=true

