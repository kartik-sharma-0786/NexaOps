# NexaOps API — copy to .env and fill in values.

# Postgres connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/nexaops_db

# Redis (BullMQ queue). Set NOTIFICATIONS_QUEUE_ENABLED=false to run without Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=true
NOTIFICATIONS_QUEUE_ENABLED=false

# Auth — REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRES_IN=1d

# CORS — comma-separated list of allowed browser origins.
# Falls back to NEXTAUTH_URL, then http://localhost:3000.
# CORS_ORIGINS=https://app.your-domain.com,https://your-domain.com

# SMTP — leave unset to log emails to the console instead of sending.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=NexaOps <no-reply@your-domain.com>

# Error tracking — leave unset to disable Sentry.
# SENTRY_DSN=
